---
import Base from "../layouts/Base.astro";

const title = "hey, i'm hanz";
const description =
  "i study computer science at the university of waterloo. i like building things and solving problems. currently at rilla, building speech analytics for outside sales teams.";
---

<Base title={title} description={description} path="/" bodyClass="background-image index-body">
  <Fragment slot="head">
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Hanz Po",
      "givenName": "Hanz",
      "familyName": "Po",
      "url": "https://hanzpo.com",
      "email": "hnqpo@uwaterloo.ca",
      "image": "https://hanzpo.com/opengraph-image.png",
      "description": "Computer science student at the University of Waterloo with an interest in building useful, elegant, and scalable software. Experienced in full-stack development, AI/ML data quality, and distributed systems.",
      "jobTitle": "Computer Science Student",
      "affiliation": [
        {
          "@type": "CollegeOrUniversity",
          "name": "University of Waterloo",
          "url": "https://uwaterloo.ca",
          "location": {
            "@type": "Place",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Waterloo",
              "addressRegion": "Ontario",
              "addressCountry": "CA"
            }
          }
        },
        {
          "@type": "Organization",
          "name": "Wat Street",
          "description": "University of Waterloo quantitative finance and machine learning club."
        }
      ],
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "degree",
        "educationalLevel": "Bachelor's",
        "about": { "@type": "DefinedTerm", "name": "Bachelor of Computer Science" },
        "recognizedBy": { "@type": "CollegeOrUniversity", "name": "University of Waterloo" }
      },
      "knowsAbout": [
        "Software Engineering", "Full-Stack Development", "Backend Development",
        "Distributed Systems", "Point of Sale Systems", "Retail Technology",
        "AI/ML Data Quality", "Large Language Model Evaluation",
        "Reinforcement Learning from Human Feedback", "Deep Learning",
        "Computer Vision", "3D Modeling", "Quantitative Finance",
        "Monte Carlo Simulation", "Option Pricing", "Prediction Markets",
        "Finance", "Urban Planning"
      ],
      "skills": [
        "Python", "JavaScript", "TypeScript", "HTML", "CSS", "Ruby", "SQL",
        "Java", "Kotlin", "C#", "C++", "C", "Lisp", "Bash", "Haskell", "Rails",
        "Flask", "React", "Next.js", "React Native", "Three.js", "Redis", "Kafka",
        "PostgreSQL", "MySQL", "GraphQL", "gRPC", "Tailwind", "FastAPI",
        "LangChain", "PyTorch", "OpenCV", "MediaPipe", "Git", "Docker", "AWS",
        "GCP", "MongoDB", "CockroachDB", "Terraform", "Node.js", "Expo",
        "Postman", "Buildkite", "Grafana"
      ],
      "hasOccupation": [
        {
          "@type": "Role",
          "roleName": "Software Engineer Intern",
          "startDate": "2026-05",
          "description": "Software engineer intern at Rilla, building speech analytics for outside sales teams.",
          "worksFor": {
            "@type": "Organization",
            "name": "Rilla",
            "description": "A speech analytics platform for outside sales and service teams."
          }
        },
        {
          "@type": "Role",
          "roleName": "Software Engineer Intern",
          "startDate": "2026-01",
          "endDate": "2026-04",
          "description": "Software engineer intern at Kalshi, building software for the world's first regulated prediction market exchange.",
          "worksFor": {
            "@type": "Organization",
            "name": "Kalshi",
            "url": "https://kalshi.com",
            "description": "A regulated financial exchange where users can trade on the outcomes of real-world events.",
            "industry": "Financial Technology"
          }
        },
        {
          "@type": "Role",
          "roleName": "Software Engineer",
          "startDate": "2025-05",
          "endDate": "2025-08",
          "description": "Developed scalable backend services using Ruby on Rails and gRPC, reducing payload sizes by 80% and latency by 42%. Built buyer profile features into retail systems, saving merchants 52+ hours/week by reducing checkout friction for 30% of customers. Leveraged GraphQL for retail-Shopify core integrations including groundwork for third-party payments in Shopify POS, impacting 100K+ merchants. Created end-to-end testing for checkout flows in the React Native Customer View app (50K+ downloads). Built Grafana dashboards and alerts for key system metrics.",
          "skills": "Ruby on Rails, gRPC, GraphQL, React Native, Grafana",
          "worksFor": {
            "@type": "Organization",
            "name": "Shopify",
            "url": "https://shopify.com",
            "description": "A leading global commerce platform powering millions of businesses worldwide.",
            "industry": "E-Commerce",
            "location": {
              "@type": "Place",
              "address": {
                "@type": "PostalAddress",
                "addressLocality": "Toronto",
                "addressRegion": "Ontario",
                "addressCountry": "CA"
              }
            }
          }
        },
        {
          "@type": "Role",
          "roleName": "Data Engineer",
          "startDate": "2024-09",
          "endDate": "2025-08",
          "description": "Improved performance for large language models by annotating and testing code tasks across AWS infrastructure, algorithms, and physics simulations. Designed over 450+ targeted test cases and identified failure modes in Python, JavaScript, C, SQL, and C++. Improved RLHF pipelines by supplying domain-specific evaluations, enabling SOTA models like Command A to reach 86.2% MBPP+ and 92.6% RepoQA.",
          "skills": "Python, JavaScript, C, SQL, C++, RLHF, LLM Evaluation",
          "worksFor": {
            "@type": "Organization",
            "name": "Cohere",
            "url": "https://cohere.com",
            "description": "An enterprise AI company building large language models and NLP solutions.",
            "industry": "Artificial Intelligence",
            "location": {
              "@type": "Place",
              "address": {
                "@type": "PostalAddress",
                "addressLocality": "Toronto",
                "addressRegion": "Ontario",
                "addressCountry": "CA"
              }
            }
          }
        },
        {
          "@type": "Role",
          "roleName": "Machine Learning Engineer",
          "startDate": "2024-11",
          "description": "Implemented and optimized deep learning models in PyTorch, achieving 96.8% accuracy on CIFAR-10. Developed a Monte Carlo simulation framework for European option pricing with 5,000+ simulations per contract.",
          "skills": "PyTorch, Deep Learning, Monte Carlo Simulation, Quantitative Finance",
          "worksFor": {
            "@type": "Organization",
            "name": "Wat Street",
            "description": "University of Waterloo quantitative finance and machine learning club."
          }
        }
      ],
      "award": [
        "Y Combinator Unicorn Prize Winner at Hack the North ($2,000) for ShapeShift",
        "Databricks Award Winner for The Exercists"
      ],
      "mainEntityOfPage": { "@type": "WebPage", "@id": "https://hanzpo.com" },
      "sameAs": [
        "https://github.com/HanzPo",
        "https://www.linkedin.com/in/hanznathanpo/",
        "https://x.com/hanzpo",
        "https://www.instagram.com/hanznathanpo"
      ]
    })} />
  </Fragment>

  <a href="#main-content" class="skip-link">skip to main content</a>

  <div class="index-grid" id="main-content">
    <!-- Left column: intro + links. Fixed; does not scroll. -->
    <div class="index-left">
      <div class="intro">
        <h1 class="hero-title animate-item" style="--d: 0.12s">hey, i'm hanz.</h1>

        <p class="hero-description animate-item" style="--d: 0.24s">
          i study computer science at the university of waterloo. i like
          building things and solving problems. currently at rilla, building
          speech analytics for outside sales teams.
        </p>
      </div>

      <div class="social">
        <h2 class="section-title animate-item" style="--d: 0.4s">find me here:</h2>
        <div class="social-links">
          <a href="https://www.github.com/HanzPo" class="social-link animate-item" style="--d: 0.48s" target="_blank" rel="noopener noreferrer">github</a>
          <a href="https://www.linkedin.com/in/hanznathanpo/" class="social-link animate-item" style="--d: 0.54s" target="_blank" rel="noopener noreferrer">linkedin</a>
          <a href="https://x.com/hanzpo" class="social-link animate-item" style="--d: 0.6s" target="_blank" rel="noopener noreferrer">twitter</a>
          <a href="https://www.instagram.com/hanznathanpo" class="social-link animate-item" style="--d: 0.66s" target="_blank" rel="noopener noreferrer">instagram</a>
          <a href="mailto:hnqpo@uwaterloo.ca" class="social-link animate-item" style="--d: 0.72s">email</a>
        </div>
        <div class="webring animate-item" style="--d: 0.8s">
          <a href="https://cs.uwatering.com/#https://hanzpo.com?nav=prev" aria-label="Previous site in CS Webring">←</a>
          <a href="https://cs.uwatering.com/#https://hanzpo.com" target="_blank" rel="noopener noreferrer" aria-label="CS Webring">
            <img src="https://cs.uwatering.com/icon.white.svg" alt="CS Webring" width="24" height="24" />
          </a>
          <a href="https://cs.uwatering.com/#https://hanzpo.com?nav=next" aria-label="Next site in CS Webring">→</a>
        </div>
      </div>
    </div>

    <!-- Right column: the only scrollable region. -->
    <div class="index-right">
      <section class="panel">
        <h2 class="section-title animate-item" style="--d: 0.28s">work</h2>

        <div class="work-cards">
          <!-- Rilla -->
          <div class="work-card animate-item" style="--d: 0.36s" data-work="rilla" role="button" tabindex="0">
            <div class="work-card-left">
              <div class="work-logo">
                <img src="/images/rilla.png" alt="rilla logo" class="logo-cover" />
              </div>
              <div class="work-info">
                <h3 class="work-company">rilla</h3>
                <p class="work-role">software engineer intern</p>
              </div>
            </div>
            <div class="work-dates">may 2026 - present</div>
          </div>

          <!-- Kalshi -->
          <div class="work-card animate-item" style="--d: 0.44s" data-work="kalshi" role="button" tabindex="0">
            <div class="work-card-left">
              <div class="work-logo">
                <img src="/images/kalshi.png" alt="kalshi logo" class="logo-cover" />
              </div>
              <div class="work-info">
                <h3 class="work-company">kalshi</h3>
                <p class="work-role">software engineer intern</p>
              </div>
            </div>
            <div class="work-dates">jan 2026 - apr 2026</div>
          </div>

          <!-- Shopify -->
          <div class="work-card animate-item" style="--d: 0.52s" data-work="shopify" role="button" tabindex="0">
            <div class="work-card-left">
              <div class="work-logo white-bg">
                <img src="/images/shopify_glyph.svg" alt="shopify logo" class="logo-contain" />
              </div>
              <div class="work-info">
                <h3 class="work-company">shopify</h3>
                <p class="work-role">engineering intern</p>
              </div>
            </div>
            <div class="work-dates">may 2025 - aug 2025</div>
          </div>

          <!-- Cohere -->
          <div class="work-card animate-item" style="--d: 0.6s" data-work="cohere" role="button" tabindex="0">
            <div class="work-card-left">
              <div class="work-logo white-bg">
                <img src="/images/cohere_logo.svg" alt="cohere logo" class="logo-contain" />
              </div>
              <div class="work-info">
                <h3 class="work-company">cohere</h3>
                <p class="work-role">senior data quality specialist</p>
              </div>
            </div>
            <div class="work-dates">sept 2024 - aug 2025</div>
          </div>
        </div>
      </section>

      <section class="panel">
        <h2 class="section-title animate-item" style="--d: 0.68s">school</h2>

        <div class="school-card animate-item" style="--d: 0.76s">
          <div class="work-logo white-bg round-mark">
            <img src="/images/uwaterloo.svg" alt="university of waterloo logo" class="logo-contain" />
          </div>
          <div>
            <h3 class="school-name">university of waterloo</h3>
            <p class="school-degree">computer science</p>
          </div>
        </div>
      </section>

      <section class="panel">
        <h2 class="section-title animate-item" style="--d: 0.84s">projects</h2>

        <div class="project-cards">
          <a
            class="project-card animate-item"
            style="--d: 0.92s"
            href="https://kalshi.tools"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div>
              <h3 class="project-name">kalshi.tools</h3>
            </div>
            <span class="project-link">visit →</span>
          </a>

          <a
            class="project-card animate-item"
            style="--d: 1s"
            href="https://riverchat.app"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div>
              <h3 class="project-name">riverchat.app</h3>
              <p class="project-tagline">
                a graph-based llm interface that allows you to explore multiple
                conversation paths
              </p>
            </div>
            <span class="project-link">visit →</span>
          </a>
        </div>
      </section>
    </div>
  </div>

  <!-- Experience Modal -->
  <div id="modal" class="modal" aria-hidden="true">
    <div class="modal-backdrop"></div>
    <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <button class="modal-close" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <div class="modal-header">
        <div class="modal-logo" id="modal-logo">
          <img id="modal-logo-img" src="" alt="" />
        </div>
        <div class="modal-info">
          <h3 id="modal-title"></h3>
          <p id="modal-dates"></p>
        </div>
      </div>
      <p id="modal-description"></p>
    </div>
  </div>
</Base>

<script>
  import "../scripts/main.js";
</script>
